// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  CLIENTE
  ADMIN
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  CANCELADO
  REEMBOLSADO
}

enum FormatoImagen {
  JPG
  PNG
  WEBP
}

model Usuario {
  id            Int        @id @default(autoincrement())
  nombre        String     @db.VarChar(100)
  apellido      String     @db.VarChar(100)
  direccion     String     @db.Text
  email         String     @unique
  passwordHash  String     @map("password_hash")
  rol           RolUsuario @default(CLIENTE)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  pedidos            Pedido[]
  tokensRecuperacion TokenRecuperacion[]
  sesionesAuth       SesionAuth[]

  @@map("usuarios")
}

model TokenRecuperacion {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique @map("token_hash")
  usuarioId   Int       @map("usuario_id")
  creadoEn    DateTime  @default(now()) @map("creado_en")
  expiraEn    DateTime  @map("expira_en")
  utilizadoEn DateTime? @map("utilizado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("tokens_recuperacion")
}

model Categoria {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  creadaEn DateTime @default(now()) @map("creada_en")

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id               Int           @id @default(autoincrement())
  titulo           String
  descripcion      String?
  precio           Decimal       @db.Decimal(10, 2)
  formato          FormatoImagen
  ancho            Int
  alto             Int
  publicIdPreview  String        @map("public_id_preview")
  publicIdOriginal String        @map("public_id_original")
  activo           Boolean       @default(true)
  creadoEn         DateTime      @default(now()) @map("creado_en")
  actualizadoEn    DateTime      @updatedAt @map("actualizado_en")

  categorias Categoria[]
  detalles   DetallePedido[]

  @@index([activo])
  @@map("productos")
}

model Pedido {
  id        Int          @id @default(autoincrement())
  fecha     DateTime     @default(now())
  total     Decimal      @db.Decimal(10, 2)
  estado    EstadoPedido @default(PENDIENTE)
  usuarioId Int          @map("usuario_id")

  usuario  Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  detalles DetallePedido[]

  @@index([usuarioId])
  @@index([estado])
  @@map("pedidos")
}

model DetallePedido {
  id             Int     @id @default(autoincrement())
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  pedidoId       Int     @map("pedido_id")
  productoId     Int     @map("producto_id")

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([pedidoId, productoId])
  @@index([productoId])
  @@map("detalles_pedido")
}

model SesionAuth {
  id               Int       @id @default(autoincrement())
  usuarioId        Int       @map("usuario_id")
  creadaEn         DateTime  @default(now()) @map("creada_en")
  actividadEn      DateTime  @default(now()) @map("actividad_en")
  expiraEn         DateTime  @map("expira_en")
  revocadaEn       DateTime? @map("revocada_en")
  motivoRevocacion String?   @map("motivo_revocacion")

  usuario       Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesiones_auth")
}

model RefreshToken {
  id               Int       @id @default(autoincrement())
  sesionId         Int       @map("sesion_id")
  tokenHash        String    @unique @map("token_hash")
  creadoEn         DateTime  @default(now()) @map("creado_en")
  expiraEn         DateTime  @map("expira_en")
  utilizadoEn      DateTime? @map("utilizado_en")
  revocadoEn       DateTime? @map("revocado_en")
  reemplazadoPorId Int?      @map("reemplazado_por_id")

  sesion SesionAuth @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId])
  @@index([expiraEn])
  @@index([reemplazadoPorId])
  @@map("refresh_tokens")
}
